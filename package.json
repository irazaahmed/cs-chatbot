{
  "name": "cs-chatbot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "prisma generate && node scripts/fix-whatsapp-rust-bridge.mjs",
    "dev": "next dev",
    "build": "node widget/build.mjs && next build",
    "start": "prisma db push && next start",
    "lint": "eslint",
    "seed-tenant": "tsx --env-file=.env scripts/seed-tenant.ts",
    "build:widget": "node widget/build.mjs",
    "worker": "tsx --env-file=.env worker.ts",
    "whatsapp-connector": "tsx --env-file=.env whatsapp-connector.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "cheerio": "^1.2.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^6.49.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
