generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  tenants   Tenant[]
  createdAt DateTime @default(now())
}

model Tenant {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  publicKey      String   @unique
  websiteUrl     String
  allowedDomains String[]

  verified       Boolean  @default(false)
  verifyToken    String
  verifyMethod   String?

  status         String   @default("trialing")
  planId         String   @default("starter")
  periodEnd      DateTime?

  brandConfig    Json
  systemPrompt   String   @db.Text
  language       String   @default("en")

  owner          User     @relation(fields: [ownerId], references: [id])
  documents      Document[]
  conversations  Conversation[]
  leads          Lead[]
  appointments   Appointment[]
  payments       Payment[]
  rateLimitBuckets RateLimitBucket[]

  @@index([publicKey])
}

model Document {
  id         String                   @id @default(cuid())
  tenantId   String
  sourceUrl  String
  title      String?
  content    String                   @db.Text
  embedding  Unsupported("vector(1536)")
  tokenCount Int
  // "web" (crawled page) | "pdf" (uploaded document) — which ingestion
  // pipeline produced this row. Lets replaceDocuments (crawl/recrawl) wipe
  // only web-sourced rows without touching uploaded PDFs, and vice versa.
  kind       String                   @default("web")

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Job {
  id         String    @id @default(cuid())
  tenantId   String
  type       String
  status     String    @default("pending")
  payload    Json
  progress   Json?
  error      String?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
}

model Conversation {
  id           String   @id @default(cuid())
  tenantId     String
  sessionId    String
  messages     Json
  answered     Boolean  @default(true)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, sessionId])
}

model Lead {
  id             String   @id @default(cuid())
  tenantId       String
  name           String?
  email          String?
  phone          String?
  interest       String?                   // what service/topic the visitor asked about
  conversationId String?
  createdAt      DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Captured conversationally by the same structured-extraction pass that
// captures Lead rows (see lib/ai/extract.ts) — a visitor asking to book gets
// their name/contact/requested time pulled out of the chat, no widget form.
// requestedTime is free text as the visitor expressed it (e.g. "tomorrow
// 3pm", "kal shaam ko") rather than a parsed DateTime: reliably parsing
// natural-language dates across English/Urdu/Roman Urdu needs a real
// scheduling design of its own, so v1 leaves the actual time-slot
// confirmation to the business owner, same as they'd handle a phone-in
// booking request.
model Appointment {
  id             String   @id @default(cuid())
  tenantId       String
  name           String?
  contact        String?
  requestedTime  String?
  notes          String?
  conversationId String?
  status         String   @default("requested") // requested | confirmed | canceled
  createdAt      DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Payment {
  id          String    @id @default(cuid())
  tenantId    String
  invoiceRef  String    @unique
  planId      String    @default("starter") // plan the tenant is paying to be on; applied to Tenant.planId on approval
  billingCycle String   @default("monthly") // monthly | quarterly | yearly; sets the period length on approval
  amountPKR   Int
  method      String
  senderName  String
  proofUrl    String
  status      String    @default("submitted")
  periodStart DateTime
  periodEnd   DateTime
  reviewedAt  DateTime?
  note        String?

  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// Not in the core CLAUDE.md model list, but additive per section 4's
// "extend as needed" — backs the Postgres-based rate limiter (section 10).
model RateLimitBucket {
  id          String   @id @default(cuid())
  tenantId    String
  key         String   // "ip:<address>" or "tenant"
  windowStart DateTime
  count       Int      @default(0)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, windowStart])
}
