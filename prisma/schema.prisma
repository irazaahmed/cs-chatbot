generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  // Null for accounts created via Google sign-in (no password set) — the
  // Credentials provider's authorize() rejects login for those, they must
  // use the Google button instead.
  passwordHash String?
  tenants      Tenant[]
  createdAt    DateTime @default(now())
}

model Tenant {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  publicKey      String   @unique
  websiteUrl     String
  allowedDomains String[]

  // Website and WhatsApp are two independent, self-serve channels. Each has
  // its own on/off toggle and its own status/period pair below, so enabling,
  // disabling, or billing one never touches the other. No ownership proof is
  // required for either — allowedDomains is populated straight from the URL
  // the tenant enters when they turn the website channel on (see
  // lib/tenant/channels.ts); the origin allowlist, rate limiting, usage caps,
  // and Turnstile are the defense layers instead.
  websiteEnabled Boolean   @default(false)
  status         String    @default("inactive") // inactive | trialing | active | past_due | suspended | canceled
  planId         String    @default("starter")
  periodEnd      DateTime?

  whatsappStatus    String    @default("inactive") // inactive | trialing | active | past_due | suspended
  whatsappPeriodEnd DateTime?
  whatsappEnabled   Boolean   @default(false)

  brandConfig  Json
  systemPrompt String @db.Text
  language     String @default("en")

  owner            User              @relation(fields: [ownerId], references: [id])
  documents        Document[]
  conversations    Conversation[]
  leads            Lead[]
  appointments     Appointment[]
  payments         Payment[]
  rateLimitBuckets RateLimitBucket[]
  whatsappAccount  WhatsAppAccount?

  @@index([publicKey])
}

// One WhatsApp Business number per tenant (v1). authState holds the Baileys
// AuthenticationState (creds + signal keys) as JSON so the connector survives
// redeploys without a mounted volume — see lib/whatsapp/pg-auth-state.ts.
model WhatsAppAccount {
  id          String    @id @default(cuid())
  tenantId    String    @unique
  phoneNumber String?
  status      String    @default("disconnected") // disconnected | pairing | connected
  authState   Json?
  qrCode      String?
  // Unused (the phone-number pairing feature was removed) but left in place
  // rather than dropped: `prisma db push` runs in production's start command
  // without --accept-data-loss, so a column drop would fail the whole boot.
  pairingCode String?
  connectedAt DateTime?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Document {
  id         String                      @id @default(cuid())
  tenantId   String
  sourceUrl  String
  title      String?
  content    String                      @db.Text
  embedding  Unsupported("vector(1536)")
  tokenCount Int
  // "web" (crawled page) | "pdf" (uploaded document) — which ingestion
  // pipeline produced this row. Lets replaceDocuments (crawl/recrawl) wipe
  // only web-sourced rows without touching uploaded PDFs, and vice versa.
  kind       String                      @default("web")
  // On-disk path for kind != "web" uploads (see lib/knowledge/file-storage.ts).
  // Null for crawled pages. Lets a delete (per-item or whole-account) also
  // remove the physical file instead of just the DB rows.
  filePath   String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Job {
  id         String    @id @default(cuid())
  tenantId   String
  type       String
  status     String    @default("pending")
  payload    Json
  progress   Json?
  error      String?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
}

model Conversation {
  id           String   @id @default(cuid())
  tenantId     String
  sessionId    String
  messages     Json
  answered     Boolean  @default(true)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  channel      String   @default("web") // web | whatsapp
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, sessionId])
}

model Lead {
  id             String   @id @default(cuid())
  tenantId       String
  name           String?
  email          String?
  phone          String?
  interest       String? // what service/topic the visitor asked about
  conversationId String?
  channel        String   @default("web") // web | whatsapp
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Captured conversationally by the same structured-extraction pass that
// captures Lead rows (see lib/ai/extract.ts) — a visitor asking to book gets
// their name/contact/requested time pulled out of the chat, no widget form.
// requestedTime is free text as the visitor expressed it (e.g. "tomorrow
// 3pm", "kal shaam ko") rather than a parsed DateTime: reliably parsing
// natural-language dates across English/Urdu/Roman Urdu needs a real
// scheduling design of its own, so v1 leaves the actual time-slot
// confirmation to the business owner, same as they'd handle a phone-in
// booking request.
model Appointment {
  id             String   @id @default(cuid())
  tenantId       String
  name           String?
  contact        String?
  requestedTime  String?
  notes          String?
  conversationId String?
  status         String   @default("requested") // requested | confirmed | canceled
  channel        String   @default("web") // web | whatsapp
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Payment {
  id           String    @id @default(cuid())
  tenantId     String
  invoiceRef   String    @unique
  planId       String    @default("starter") // plan the tenant is paying to be on; applied to Tenant.planId on approval
  billingCycle String    @default("monthly") // monthly | quarterly | yearly; sets the period length on approval
  addon        String? // null = normal plan payment; "whatsapp" = WhatsApp channel payment (applies to Tenant.whatsappStatus/whatsappPeriodEnd instead of planId/status)
  amountPKR    Int
  method       String
  senderName   String
  proofUrl     String
  status       String    @default("submitted")
  periodStart  DateTime
  periodEnd    DateTime
  reviewedAt   DateTime?
  note         String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// Not in the core CLAUDE.md model list, but additive per section 4's
// "extend as needed" — backs the Postgres-based rate limiter (section 10).
model RateLimitBucket {
  id          String   @id @default(cuid())
  tenantId    String
  key         String // "ip:<address>" or "tenant"
  windowStart DateTime
  count       Int      @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, windowStart])
}
