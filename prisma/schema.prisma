generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  tenants   Tenant[]
  createdAt DateTime @default(now())
}

model Tenant {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  publicKey      String   @unique
  websiteUrl     String
  allowedDomains String[]

  verified       Boolean  @default(false)
  verifyToken    String
  verifyMethod   String?

  status         String   @default("trialing")
  planId         String   @default("starter")
  periodEnd      DateTime?

  brandConfig    Json
  systemPrompt   String   @db.Text
  language       String   @default("en")

  owner          User     @relation(fields: [ownerId], references: [id])
  documents      Document[]
  conversations  Conversation[]
  leads          Lead[]
  payments       Payment[]
  rateLimitBuckets RateLimitBucket[]

  @@index([publicKey])
}

model Document {
  id         String                   @id @default(cuid())
  tenantId   String
  sourceUrl  String
  title      String?
  content    String                   @db.Text
  embedding  Unsupported("vector(1536)")
  tokenCount Int

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Job {
  id         String    @id @default(cuid())
  tenantId   String
  type       String
  status     String    @default("pending")
  payload    Json
  progress   Json?
  error      String?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
}

model Conversation {
  id           String   @id @default(cuid())
  tenantId     String
  sessionId    String
  messages     Json
  answered     Boolean  @default(true)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, sessionId])
}

model Lead {
  id             String   @id @default(cuid())
  tenantId       String
  name           String?
  email          String?
  phone          String?
  conversationId String?
  createdAt      DateTime @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Payment {
  id          String    @id @default(cuid())
  tenantId    String
  invoiceRef  String    @unique
  planId      String    @default("starter") // plan the tenant is paying to be on; applied to Tenant.planId on approval
  billingCycle String   @default("monthly") // monthly | quarterly | yearly; sets the period length on approval
  amountPKR   Int
  method      String
  senderName  String
  proofUrl    String
  status      String    @default("submitted")
  periodStart DateTime
  periodEnd   DateTime
  reviewedAt  DateTime?
  note        String?

  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// Not in the core CLAUDE.md model list, but additive per section 4's
// "extend as needed" — backs the Postgres-based rate limiter (section 10).
model RateLimitBucket {
  id          String   @id @default(cuid())
  tenantId    String
  key         String   // "ip:<address>" or "tenant"
  windowStart DateTime
  count       Int      @default(0)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, windowStart])
}
