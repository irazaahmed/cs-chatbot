# Neon Postgres connection string, pgvector extension will be created automatically
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# OpenAI API key, used only via lib/ai/provider.ts
OPENAI_API_KEY="sk-..."

# Auth.js v5 — Google OAuth only (CLAUDE.md section 2)
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET="..."
AUTH_GOOGLE_ID="....apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="..."

# Platform admin (comma-separated emails) — gates /admin payment approvals,
# also where the payment-submitted notification email goes (lib/email/notify.ts)
ADMIN_EMAILS="you@example.com"

# Transactional email (welcome, trial-end, payment events) via the Resend REST
# API, lib/email/provider.ts only, no SDK. Reuses the same Resend account as
# Cybrum Solutions' info@ — cybrumsolutions.dev is already domain-verified
# there, so any @cybrumsolutions.dev from-address works with the same key,
# no extra DNS needed.
RESEND_API_KEY="re_..."
EMAIL_FROM_ADDRESS="CS Chatbot <chatbot@cybrumsolutions.dev>"

# Manual billing (CLAUDE.md section 9) — real payment account details
PAYMENT_JAZZCASH_NUMBER="0300-0000000"
PAYMENT_EASYPAISA_NUMBER="0300-0000000"
PAYMENT_BANK_ACCOUNT_TITLE="Cybrum Solutions"
PAYMENT_BANK_ACCOUNT_NUMBER="0000000000000"
PAYMENT_BANK_IBAN="PK00XXXX0000000000000000"
PAYMENT_BANK_NAME="Bank name"

# Plan prices in PKR — one per plan × billing cycle. These override the
# compiled-in defaults in lib/billing/plans.ts (which already match these).
# Quarterly = 10% off 3 months, yearly = 20% off 12 months.
PLAN_PRICE_PKR_STARTER_MONTHLY="3500"
PLAN_PRICE_PKR_STARTER_QUARTERLY="9450"
PLAN_PRICE_PKR_STARTER_YEARLY="33600"
PLAN_PRICE_PKR_PRO_MONTHLY="9000"
PLAN_PRICE_PKR_PRO_QUARTERLY="24300"
PLAN_PRICE_PKR_PRO_YEARLY="86400"
PLAN_PRICE_PKR_BUSINESS_MONTHLY="24000"
PLAN_PRICE_PKR_BUSINESS_QUARTERLY="64800"
PLAN_PRICE_PKR_BUSINESS_YEARLY="230400"

# WhatsApp channel prices in PKR. "Bundle" applies when paid alongside an
# active/being-purchased website plan, "standalone" otherwise. Same 10%/20%
# quarterly/yearly discount as above. Overrides lib/billing/plans.ts.
PLAN_PRICE_PKR_WHATSAPP_BUNDLE_MONTHLY="4500"
PLAN_PRICE_PKR_WHATSAPP_BUNDLE_QUARTERLY="12150"
PLAN_PRICE_PKR_WHATSAPP_BUNDLE_YEARLY="43200"
PLAN_PRICE_PKR_WHATSAPP_STANDALONE_MONTHLY="5000"
PLAN_PRICE_PKR_WHATSAPP_STANDALONE_QUARTERLY="13500"
PLAN_PRICE_PKR_WHATSAPP_STANDALONE_YEARLY="48000"

# Instagram channel (Phase Instagram-1: connect only, no billing/webhook yet).
# ONE shared Meta App for all tenants (like AUTH_GOOGLE_ID is one shared
# Google OAuth client for all users' logins) — tenants don't create their own
# Meta App, they consent through this one App's OAuth screen. App ID/Secret
# come from developers.facebook.com under App Settings > Basic.
INSTAGRAM_APP_ID="..."
INSTAGRAM_APP_SECRET="..."
INSTAGRAM_REDIRECT_URI="https://chatbot.cybrumsolutions.dev/api/instagram/oauth/callback"

# Headless-render fallback for JS-heavy (CSR) sites, lib/crawl/browser.ts.
# Triggers when a static fetch yields under this many chars of readable
# text. All optional — if no Chromium binary is found (see nixpacks.toml),
# the fallback silently disables itself and the crawler behaves exactly as
# it did before this feature.
# HEADLESS_FALLBACK_MIN_CHARS="200"
# HEADLESS_RENDER_TIMEOUT_MS="12000"
# HEADLESS_RENDER_CONCURRENCY="2"
# PLAYWRIGHT_CHROMIUM_PATH="/usr/bin/chromium"

# Bot-protection (Cloudflare et al.) block detection retries only "blocked"
# outcomes, not timeouts/crashes — their scoring is adaptive, so the same
# page can be blocked once and let through moments later. Total attempts
# (2 = one retry).
# HEADLESS_BLOCKED_RETRY_ATTEMPTS="2"
# HEADLESS_BLOCKED_RETRY_DELAY_MS="1500"
